# Copy to ignored .env; never commit credentials or server addresses.
ADMTUNE_SSH_HOST=
ADMTUNE_SSH_PORT=22
ADMTUNE_SSH_USER=
ADMTUNE_SSH_PASSWORD=
ADMTUNE_MYSQL_PASSWORD=
AGENTICDB_SUDO_PASSWORD=

# Only required for an explicitly authorized --allow-paid-llm static tune.
# Use the endpoint/model that you actually intend to pay for; no default choice.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_RESPONSE_RETRIES=0
OPENAI_TIMEOUT_S=120
# 仅在服务商明确支持此参数时设置；空值不向接口发送该参数。
OPENAI_ENABLE_THINKING=
